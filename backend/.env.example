MONGO_URL=mongodb://localhost:27017
DB_NAME=dialygo_local

# Required relational URL. This application and its Alembic migrations use PostgreSQL.
DATABASE_URL=postgresql+asyncpg://dialygo@localhost:5432/dialygo

# Optional storage override; otherwise backend/storage is used.
# STORAGE_DIR=./storage

JWT_SECRET=replace-with-a-private-local-development-secret
AADHAAR_PEPPER=replace-with-a-private-local-development-pepper

# Development-only mock OTP behavior. Never use these settings in production.
OTP_DEBUG=true
OTP_FIXED_CODE=123456

# Comma-separated exact browser origins; the backend does not trim spaces.
CORS_ORIGINS=http://localhost:3000

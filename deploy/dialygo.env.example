# Copy to /etc/dialygo/dialygo.env and replace every placeholder before starting.
# Keep root-owned and readable only by root and the dialygo service group.
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=REPLACE_WITH_PRODUCTION_DATABASE_NAME
DATABASE_URL=postgresql+asyncpg://REPLACE_WITH_DB_USER:REPLACE_WITH_URL_ENCODED_PASSWORD@127.0.0.1:5432/REPLACE_WITH_DB_NAME

JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
AADHAAR_PEPPER=REPLACE_WITH_DIFFERENT_LONG_RANDOM_SECRET
JWT_TTL_SECONDS=604800
OTP_DEBUG=false
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
ERROR_LOG_RETENTION_DAYS=365

STORAGE_DIR=/var/lib/dialygo/uploads
CORS_ORIGINS=REPLACE_WITH_CONFIRMED_ORIGIN
